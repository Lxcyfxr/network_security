#!/bin/python3
import base64
from scapy.all import sniff, ICMP, Raw, checksum, IP, PcapWriter
import os
import sys
ident = 0x4242
buffer = {}
writer = PcapWriter("server.pcap",append = True, sync = True)

if os.geteuid() != 0:
    sys.exit("Bitte mit sudo starten.")

def chksum_test(pkt):
    empfangen = pkt[ICMP].chksum
    icmp_len = pkt[IP].len - pkt[IP].ihl * 4
    raw = bytes(pkt[ICMP])[:icmp_len]
    genullt = raw[:2] + b"\x00\x00" + raw[4:]
    return checksum(genullt) == empfangen


    
def checker(pkt):
    if not (pkt.haslayer(ICMP) and pkt.haslayer(Raw)):
        return
    icmp = pkt[ICMP]
    print("GESEHEN type", icmp.type, "id", hex(icmp.id), "seq", icmp.seq)
    if icmp.id != ident or icmp.type !=8:
        return print("filter verworfen")
    if not chksum_test(pkt):
        return print(f"checksumme falsch for {icmp.seq}")
    if icmp.seq == 0:
        print("ende erreciht",sorted(buffer))
        daten = b"".join(buffer[k] for k in sorted(buffer))
        daten = base64.b64decode(daten).decode("utf-8")
        with open("sniffed.txt", "a", encoding="utf-8") as f:
            f.write(daten)
        return print("Data caputured")
    else:
        buffer[icmp.seq] = bytes(pkt[Raw].load)

def handle(pkt):
    writer.write(pkt)
    checker(pkt)


print("Sniffer läuft:")
#sniff(filter="icmp", prn=checker, store=0)
try:
    sniff(iface="enp0s8",prn=handle, store=0)
finally:
    writer.close()
